cat > .gitignore << 'EOF'
# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React build
build/

# Truffle
.truffle-cache/

# Environment & secrets — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.secret
.mnemonic
mnemonic.txt
privatekey.txt

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*~

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
*.tmp
coverage/
.nyc_output/
EOF